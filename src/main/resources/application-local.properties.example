# Bu dosyayı "application-local.properties" adıyla kopyala ve kendi bilgilerini yaz.
# application-local.properties .gitignore'da olduğu için GitHub'a gönderilmez.

# SQL Server Express kullanıyorsan ve TCP portu 1433 değilse instanceName ekleyebilirsin:
# spring.datasource.url=jdbc:sqlserver://localhost;instanceName=SQLEXPRESS;databaseName=OGVPTS;encrypt=true;trustServerCertificate=true
spring.datasource.url=jdbc:sqlserver://localhost:1433;databaseName=OGVPTS;encrypt=true;trustServerCertificate=true
spring.datasource.username=sa
spring.datasource.password=SIFRENI_BURAYA_YAZ
